<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
* { margin:0; padding:0; box-sizing:border-box; }
body {
  width:1200px; height:630px; overflow:hidden;
  background:#070511;
  font-family:'Segoe UI',system-ui,sans-serif;
  position:relative;
}
.glow1 { position:absolute; width:700px; height:700px; border-radius:50%; background:radial-gradient(circle,rgba(124,58,237,.3) 0%,transparent 70%); top:-200px; left:-150px; }
.glow2 { position:absolute; width:500px; height:500px; border-radius:50%; background:radial-gradient(circle,rgba(236,72,153,.2) 0%,transparent 70%); bottom:-100px; right:50px; }
.wrap { display:flex; align-items:center; justify-content:space-between; padding:55px 75px; height:100%; position:relative; z-index:1; }
.left { flex:1; padding-right:40px; }
.badge { display:inline-flex; align-items:center; gap:8px; background:rgba(124,58,237,.2); border:1px solid rgba(124,58,237,.5); color:#c4b5fd; font-size:13px; font-weight:700; padding:6px 16px; border-radius:99px; margin-bottom:22px; letter-spacing:.06em; text-transform:uppercase; }
h1 { font-size:62px; font-weight:900; line-height:1.08; color:#fff; margin-bottom:18px; }
h1 em { font-style:normal; background:linear-gradient(135deg,#a78bfa,#f472b6); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
.sub { font-size:20px; color:rgba(255,255,255,.5); line-height:1.5; margin-bottom:28px; }
.pills { display:flex; gap:10px; }
.pill { background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.13); color:rgba(255,255,255,.65); font-size:13px; font-weight:600; padding:7px 16px; border-radius:99px; }
.right { width:360px; flex-shrink:0; }
.card { background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.1); border-radius:20px; padding:26px; }
.card-top { display:flex; justify-content:space-between; align-items:center; margin-bottom:18px; }
.card-badge { font-size:11px; font-weight:800; text-transform:uppercase; letter-spacing:.08em; color:#a78bfa; background:rgba(167,139,250,.15); padding:4px 12px; border-radius:99px; }
.card-num { font-size:11px; color:rgba(255,255,255,.3); }
.card-name { font-size:19px; font-weight:800; color:#fff; margin-bottom:3px; }
.card-client { font-size:12px; color:rgba(255,255,255,.35); margin-bottom:18px; }
.line { display:flex; justify-content:space-between; font-size:12px; color:rgba(255,255,255,.45); margin-bottom:7px; }
.divider { border:none; border-top:1px solid rgba(255,255,255,.08); margin:14px 0; }
.total-row { display:flex; justify-content:space-between; }
.total-lbl { font-size:13px; color:rgba(255,255,255,.55); font-weight:600; }
.total-val { font-size:20px; font-weight:900; color:#a78bfa; }
.domain { position:absolute; bottom:22px; right:75px; font-size:14px; font-weight:700; color:rgba(255,255,255,.2); letter-spacing:.06em; }
</style>
</head>
<body>
<div class="glow1"></div>
<div class="glow2"></div>
<div class="wrap">
  <div class="left">
    <div class="badge">🇵🇰 Made for Pakistan</div>
    <h1>Free Invoice<br>Generator for<br><em>Freelancers</em></h1>
    <p class="sub">Create, send & get paid in minutes.<br>PKR 199 per PDF · No subscription.</p>
    <div class="pills">
      <span class="pill">✓ EasyPaisa</span>
      <span class="pill">✓ JazzCash</span>
      <span class="pill">✓ PayPal</span>
    </div>
  </div>
  <div class="right">
    <div class="card">
      <div class="card-top">
        <span class="card-badge">Invoice</span>
        <span class="card-num">INV-042</span>
      </div>
      <div class="card-name">Ahmed Solutions</div>
      <div class="card-client">Billed to: Client Pvt Ltd</div>
      <div class="line"><span>Web Development</span><span>₨45,000</span></div>
      <div class="line"><span>UI/UX Design</span><span>₨18,000</span></div>
      <div class="line"><span>SEO Setup</span><span>₨12,000</span></div>
      <hr class="divider">
      <div class="total-row">
        <span class="total-lbl">Total Due</span>
        <span class="total-val">₨75,000</span>
      </div>
    </div>
  </div>
</div>
<div class="domain">fineinvoice.com</div>
</body>
</html>